FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --no-default-groups --extra frontend

COPY src/ ./src/
COPY front-end/ ./front-end/

RUN uv sync --frozen --no-dev --no-default-groups --extra frontend

EXPOSE 8501

ENV API_URL=http://backend:8000/classifier/

CMD ["uv", "run", "streamlit", "run", "front-end/app.py", "--server.port=8501", "--server.address=0.0.0.0"]